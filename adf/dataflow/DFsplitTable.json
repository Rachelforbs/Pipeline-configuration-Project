{
	"name": "DFsplitTable",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "usersink",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "UserSK",
						"type": "DatasetReference"
					},
					"name": "UserTableSink"
				},
				{
					"dataset": {
						"referenceName": "UserDetailSink",
						"type": "DatasetReference"
					},
					"name": "UserDetailTablesink"
				}
			],
			"transformations": [
				{
					"name": "userSelectTable"
				},
				{
					"name": "UserDetailselectTable"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as integer,",
				"          name as string,",
				"          username as string,",
				"          email as string,",
				"          address as (street as string, suite as string, city as string, zipcode as string, geo as (lat as string, lng as string)),",
				"          phone as string,",
				"          website as string,",
				"          company as (name as string, catchPhrase as string, bs as string)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine',",
				"     partitionBy('hash', 1)) ~> source1",
				"source1 select(mapColumn(",
				"          UserID = id,",
				"          Name = name,",
				"          Email = email,",
				"          Phone = phone,",
				"          Website = website",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> userSelectTable",
				"source1 select(mapColumn(",
				"          UserID = id,",
				"          Street = address.street,",
				"          City = address.city,",
				"          Zipcode = address.zipcode,",
				"          Company = company.name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> UserDetailselectTable",
				"userSelectTable sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> UserTableSink",
				"UserDetailselectTable sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> UserDetailTablesink"
			]
		}
	}
}